# ============================================================================
# Template for claude/secrets.env  (committed in PLAINTEXT — no real secrets)
# ============================================================================
# The real file `claude/secrets.env` is git-crypt encrypted. On a new machine:
#
#   1. Get the secrets automatically:  git-crypt unlock /path/to/dotfiles-gitcrypt.key
#      (the key is exported once from your main machine and stored securely,
#       e.g. in a password manager — NEVER commit it)
#
#   2. OR, without the key, copy this template and fill in by hand:
#        cp claude/secrets.env.example claude/secrets.env
#
# Each `export KEY=VALUE` in secrets.env is used in TWO places:
#   1. Shell  — ~/.zshrc sources it (terminal tools inherit it).
#   2. Claude — claude/gen-claude-settings.py injects it into the `env` block of
#               ~/.claude/settings.json, making it a GLOBAL Claude env var that
#               applies to every Claude Code session regardless of launch method.
#
# After unlocking, run:  python3 ~/.config/dotfiles/claude/gen-claude-settings.py
# ============================================================================

# export GITHUB_TOKEN="ghp_..."
# export OPENAI_API_KEY="sk-..."
